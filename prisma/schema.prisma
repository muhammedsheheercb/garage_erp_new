generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "windows"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Admin {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Employee {
  id          String   @id @default(uuid())
  name        String
  username    String?  @unique
  email       String   @default("employee@garage.com")
  password    String
  permissions String   @default("[]")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([email])
}

model Customer {
  id        String    @id @default(uuid())
  name      String
  email     String?   @unique
  phone     String?   @unique
  address   String?
  type      String?   @default("Individual")
  vehicles  Vehicle[]
  jobCards  JobCard[]
  quotations Quotation[]
  invoices  Invoice[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  @@index([createdAt])
}

model Vehicle {
  id          String    @id @default(uuid())
  brand       String
  model       String
  year        Int?
  fuelType    String?
  plateNumber String    @unique
  customerId  String
  customer    Customer  @relation(fields: [customerId], references: [id])
  jobCards    JobCard[]
  quotations  Quotation[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  @@index([customerId])
  @@index([createdAt])
}

model VehicleCompany {
  id        String         @id @default(uuid())
  name      String         @unique
  models    VehicleModel[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  @@index([createdAt])
}

model VehicleModel {
  id        String         @id @default(uuid())
  name      String
  companyId String
  company   VehicleCompany @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([companyId, name])
  @@index([companyId])
  @@index([createdAt])
}

model Mechanic {
  id        String    @id @default(uuid())
  name      String
  phone     String?
  email     String?   @unique
  jobCards  JobCard[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  @@index([createdAt])
}

model Service {
  id            String           @id @default(uuid())
  name          String
  price         Float
  estimatedTime String?
  category      String?
  jobCards      JobCardService[]
  quotations    QuotationService[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  @@index([createdAt])
}

model JobCard {
  id                 String           @id @default(uuid())
  status             String           @default("PENDING") // PENDING, IN_PROGRESS, COMPLETED
  complaint          String
  workDone           String?
  estimatedCost      Float?
  date               DateTime         @default(now())
  expectedFinishDate DateTime?
  notes              String?
  createdBy          String?
  customerId         String
  customer           Customer         @relation(fields: [customerId], references: [id])
  vehicleId          String
  vehicle            Vehicle          @relation(fields: [vehicleId], references: [id])
  mechanicId         String
  mechanic           Mechanic         @relation(fields: [mechanicId], references: [id])
  services           JobCardService[]
  parts              JobCardPart[]
  payments           Payment[]
  purchases          Purchase[]

  serviceTotal Float @default(0)
  partsTotal   Float @default(0)
  otherCharges String? // JSON string of [{ description, amount }]
  hideServicePartsAmounts Boolean @default(false)
  discount     Float @default(0)
  tax          Float @default(0)
  grandTotal   Float @default(0)
  advancePaid  Float @default(0)
  vehicleKm    Float @default(0)

  invoice   Invoice?
  quotation Quotation?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([customerId])
  @@index([vehicleId])
  @@index([mechanicId])
  @@index([status, createdAt])
  @@index([expectedFinishDate])
}

// Join table for many-to-many relationship between JobCard and Service
model JobCardService {
  id        String   @id @default(uuid())
  jobCardId String
  jobCard   JobCard  @relation(fields: [jobCardId], references: [id])
  serviceId String
  service   Service  @relation(fields: [serviceId], references: [id])
  quantity  Int      @default(1)
  price     Float // Captures the price at the time of service
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([jobCardId, serviceId])
  @@index([serviceId])
}

model JobCardPart {
  id        String         @id @default(uuid())
  jobCardId String
  jobCard   JobCard        @relation(fields: [jobCardId], references: [id])
  batchId   String
  batch     InventoryBatch @relation(fields: [batchId], references: [id])
  quantity  Int            @default(1)
  price     Float // Selling price at the time of use
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([jobCardId, batchId])
  @@index([batchId])
}

model Quotation {
  id           String             @id @default(uuid())
  status       String             @default("PENDING")
  complaint    String
  notes        String?
  date         DateTime           @default(now())
  validUntil   DateTime
  vehicleKm    Float              @default(0)
  otherCharge  Float              @default(0)
  serviceTotal Float              @default(0)
  partsTotal   Float              @default(0)
  grandTotal   Float              @default(0)
  createdBy    String?
  customerId   String
  customer     Customer           @relation(fields: [customerId], references: [id])
  vehicleId    String
  vehicle      Vehicle            @relation(fields: [vehicleId], references: [id])
  services     QuotationService[]
  parts        QuotationPart[]
  jobCardId    String?            @unique
  jobCard      JobCard?           @relation(fields: [jobCardId], references: [id])
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([customerId])
  @@index([vehicleId])
  @@index([status, createdAt])
  @@index([validUntil])
}

model QuotationService {
  id          String    @id @default(uuid())
  quotationId String
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  serviceId   String
  service     Service   @relation(fields: [serviceId], references: [id])
  quantity    Int       @default(1)
  price       Float

  @@unique([quotationId, serviceId])
  @@index([serviceId])
}

model QuotationPart {
  id          String    @id @default(uuid())
  quotationId String
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  inventoryId String
  inventory   Inventory @relation(fields: [inventoryId], references: [id])
  quantity    Int       @default(1)
  price       Float

  @@unique([quotationId, inventoryId])
  @@index([inventoryId])
}

model Invoice {
  id              String    @id @default(uuid())
  amount          Float // Kept for backward compatibility, same as grandTotal
  serviceCharge   Float     @default(0)
  labourCharge    Float     @default(0)
  partsCost       Float     @default(0)
  discount        Float     @default(0)
  tax             Float     @default(0)
  subTotal        Float     @default(0)
  grandTotal      Float     @default(0)
  otherCharges    String? // JSON string of other charges
  servicesDetails String? // Text to store services details
  partsDetails    String? // Text or JSON string to store parts used
  status          String    @default("UNPAID") // UNPAID, PARTIAL, PAID
  createdBy       String?
  customerId      String
  customer        Customer  @relation(fields: [customerId], references: [id])
  jobCardId       String    @unique
  jobCard         JobCard   @relation(fields: [jobCardId], references: [id])
  payments        Payment[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  @@index([customerId])
  @@index([createdAt])
  @@index([status, createdAt])
}

model Payment {
  id        String   @id @default(uuid())
  amount    Float
  method    String // CASH, CARD, TRANSFER
  createdBy String?
  // Kept for payments created before Job Cards became directly payable.
  invoiceId String?
  invoice   Invoice? @relation(fields: [invoiceId], references: [id])
  jobCardId String?
  jobCard   JobCard? @relation(fields: [jobCardId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([invoiceId])
  @@index([jobCardId])
  @@index([createdAt])
}

model Supplier {
  id        String            @id @default(uuid())
  name      String
  contact   String
  email     String?
  address   String?
  payments  SupplierPayment[]
  purchases Purchase[]
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  @@index([createdAt])
  @@index([name])
}

model Inventory {
  id            String           @id @default(uuid())
  itemName      String
  partNumber    String           @unique
  purchaseItems PurchaseItem[]
  batches       InventoryBatch[]
  quotations    QuotationPart[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  @@index([createdAt])
}

model InventoryBatch {
  id            String        @id @default(uuid())
  inventoryId   String
  inventory     Inventory     @relation(fields: [inventoryId], references: [id])
  batchNumber   String
  quantity      Int           @default(0) // Available quantity
  purchasePrice Float
  sellingPrice  Float
  purchaseId    String?
  purchase      Purchase?     @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  jobCardParts  JobCardPart[]
  directSaleItems DirectSaleItem[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  @@index([inventoryId])
  @@index([purchaseId])
  @@index([createdAt])
}

model DirectSale {
  id             String           @id @default(uuid())
  vehicleNumber  String
  customerName   String
  customerMobile String
  subTotal       Float            @default(0)
  discount       Float            @default(0)
  tax            Float            @default(0)
  grandTotal     Float            @default(0)
  createdBy      String?
  saleDate       DateTime         @default(now())
  items          DirectSaleItem[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  @@index([createdAt])
}

model DirectSaleItem {
  id           String         @id @default(uuid())
  directSaleId String
  directSale   DirectSale     @relation(fields: [directSaleId], references: [id], onDelete: Cascade)
  batchId      String
  batch        InventoryBatch @relation(fields: [batchId], references: [id])
  quantity     Int
  purchasePrice Float
  salesPrice   Float
  vat          Float          @default(0)
  discount     Float          @default(0)
  totalAmount  Float
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  @@index([directSaleId])
  @@index([batchId])
}

model Expense {
  id            String    @id @default(uuid())
  category      String // RENT, UTILITIES, SALARY
  amount        Float
  description   String?
  date          DateTime  @default(now())
  paidAmount    Float     @default(0)
  pendingAmount Float     @default(0)
  paymentMethod String    @default("CASH") // CASH, CARD, TRANSFER, PAYMETER
  createdBy     String?
  paymeterId    String?
  paymeter      Paymeter? @relation(fields: [paymeterId], references: [id])
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  @@index([date])
  @@index([paymeterId])
  @@index([createdAt])
}

model SupplierPayment {
  id         String   @id @default(uuid())
  amount     Float
  method     String   @default("CASH")
  date       DateTime @default(now())
  reference  String?
  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  @@index([supplierId])
  @@index([date])
}

model Setting {
  id    String @id @default(uuid())
  key   String @unique
  value String
}

model TaxSetting {
  id         String   @id @default(uuid())
  name       String
  percentage Float
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Paymeter {
  id                 String            @id @default(uuid())
  name               String            @unique
  spentAmount        Float             @default(0)
  initialSpentAmount Float             @default(0)
  purchases          Purchase[]
  purchasePayments   PurchasePayment[]
  expenses           Expense[]
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  @@index([createdAt])
}

model Purchase {
  id               String            @id @default(uuid())
  purchaseNumber   String            @unique
  purchaseDate     DateTime          @default(now())
  purchaseType     String            @default("STOCK") // "STOCK" or "VEHICLE"
  jobCardId        String?
  jobCard          JobCard?          @relation(fields: [jobCardId], references: [id])
  supplierId       String
  supplier         Supplier          @relation(fields: [supplierId], references: [id])
  paymentMethodId  String
  paymentMethod    Paymeter          @relation(fields: [paymentMethodId], references: [id])
  subTotal         Float             @default(0)
  taxRate          Float             @default(0)
  taxAmount        Float             @default(0)
  discount         Float             @default(0)
  grandTotal       Float             @default(0)
  paidAmount       Float             @default(0)
  pendingAmount    Float             @default(0)
  paymeterReimbursed Float             @default(0)
  createdBy        String?
  items            PurchaseItem[]
  batches          InventoryBatch[]
  purchasePayments PurchasePayment[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  @@index([supplierId])
  @@index([jobCardId])
  @@index([createdAt])
  @@index([purchaseDate])
}

model PurchaseItem {
  id            String    @id @default(uuid())
  purchaseId    String
  purchase      Purchase  @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  inventoryId   String
  inventory     Inventory @relation(fields: [inventoryId], references: [id])
  quantity      Int
  purchasePrice Float
  sellingPrice  Float
  taxRate       Float     @default(0)
  taxAmount     Float     @default(0)
  itemTotal     Float
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  @@index([purchaseId])
  @@index([inventoryId])
}

model PurchasePayment {
  id         String   @id @default(uuid())
  purchaseId String
  purchase   Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  paymeterId String
  paymeter   Paymeter @relation(fields: [paymeterId], references: [id])
  amount        Float
  paidAmount    Float    @default(0)
  pendingAmount Float    @default(0)
  date          DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  @@index([purchaseId])
  @@index([paymeterId])
  @@index([date])
}
