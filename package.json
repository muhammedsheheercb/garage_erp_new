{
  "name": "garage_erp",
  "version": "0.1.0",
  "description": "Garage ERP web and desktop application",
  "author": "Garage ERP",
  "private": true,
  "main": "main.js",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "electron:dev": "concurrently \"pnpm dev\" \"wait-on http://127.0.0.1:3000 && electron .\"",
    "electron:prepare": "node scripts/prepare-electron.cjs",
    "electron:build": "pnpm build && pnpm electron:prepare && electron-builder --win",
    "typecheck": "tsc --noEmit",
    "test": "node tests/payment-methods.test.mjs && node --import tsx --test src/features/settings/*.test.ts",
    "test:unit": "node tests/payment-methods.test.mjs",
    "test:backup": "node --import tsx --test src/features/settings/*.test.ts",
    "test:smoke": "node scripts/production-smoke.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@hookform/resolvers": "^5.4.0",
    "@prisma/client": "5.22.0",
    "@tanstack/react-query": "^5.101.2",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.24.0",
    "next": "16.3.6",
    "next-themes": "^0.4.6",
    "prisma": "^5.22.0",
    "react": "19.2.4",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.81.0",
    "recharts": "^3.9.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.3",
    "electron": "^43.5.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "shadcn": "^4.13.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "wait-on": "^9.0.10"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "build": {
    "appId": "com.garageerp.app",
    "productName": "Garage ERP",
    "asar": false,
    "npmRebuild": false,
    "nodeGypRebuild": false,
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis"
    },
    "files": [
      "main.js",
      "package.json",
      ".next/standalone/**/*",
      ".next/static/**/*",
      "public/**/*"
    ]
  },
  "packageManager": "pnpm@10.25.0",
  "engines": {
    "node": ">=20.19.0"
  },
  "pnpm": {
    "overrides": {
      "nanoid@3": "3.3.18",
      "browserslist@4": "4.28.7",
      "baseline-browser-mapping@2": "2.11.0"
    }
  }
}
