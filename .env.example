# Neon pooled PostgreSQL connection string. Use this exact value for the web
# deployment and the Electron-launched Next.js server.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Long random value shared by the web deployment and Electron server.
AUTH_SECRET="replace-with-a-long-random-secret"

# Keep this stable for production builds when Server Actions are deployed to
# more than one web instance.
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY="replace-with-a-base64-encoded-32-byte-key"

# Optional absolute path to private, persistent backup storage.
# Defaults to .garage-erp/backups in the server user's home directory.
# BACKUP_DIRECTORY="/var/lib/garage-erp/backups"

# Weekly automatic backup: Friday at 12:00 PM in this timezone.
BACKUP_TIMEZONE="Asia/Muscat"
# Set false on development servers or servers that should not run scheduled backups.
WEEKLY_BACKUP_ENABLED="true"
